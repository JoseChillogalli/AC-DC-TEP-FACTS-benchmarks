# RATINGS DEL SSSC --- RECONCILIADOS (rev. 2026-08-21)
#  sc_S es el termico de la RAMA compensada, no del dispositivo: una fuente
#  serie no cambia el conductor de la anfitriona. Valia 2.0 contra el_S=3.94
#  de las seis anfitrionas (E109,E106,E66,E67,E154,E76), un recorte de -49%
#  que castigaba al SSSC sin justificacion fisica (C2 se explicaba por
#  recortar E109 de 394 a 200 MVA). Se fija sc_S := el_S[anfitriona] = 3.94.
#  sc_Sabs = sc_Vmax x sc_S = 0.2 x 3.94 = 0.788 (rev. 2026-08-23).
param: LSC: sc_line sc_r sc_x sc_Vmax sc_S sc_Sabs sc_cost sc_bsh :=
  SC1  E109  0.00221  0.4115  0.2  3.94  0.788  14.29  0.050990
  SC2  E106  0.0985  0.324  0.2  3.94  0.788  14.29  0.041400
  SC3  E66  0.0715  0.323  0.2  3.94  0.788  14.29  0.043000
  SC4  E67  0.0715  0.323  0.2  3.94  0.788  14.29  0.043000
  SC5  E154  0.0648  0.295  0.2  3.94  0.788  14.29  0.023600
  SC6  E76  0.0869  0.291  0.2  3.94  0.788  14.29  0.036500
;
