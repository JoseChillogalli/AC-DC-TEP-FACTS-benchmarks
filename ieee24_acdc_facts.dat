# CORRECCIONES rev. 2026-08-21e (auditoria adversarial):
#  (1) DV17/DV18: lc 0.000002 -> 0.000153 (= 0.002295/P; la regla 0.00003/P de
#      los comentarios heredados era la errata: dejaba a los bulk con perdida
#      0.909% contra 1.136% de la clase 500 MW, cuyo reparto vacio/lineal/
#      cuadratico 26/53/20 es el fisicamente correcto de un VSC).
#  (2) Bahias de STATCOM intercambiadas: ST4 (barra 10, 138 kV) llevaba la
#      bahia de 230 kV y las cinco de 230 kV la de 138. Corregido: 33.90+1.70
#      =35.6 en 138 kV; 33.90+2.20=36.1 en 230 kV.
#  (3) CORREGIDO 2026-08-23: los bancos SI llevan bahia (2.29 = 50x11873 +
#      1.70 de 138 kV). La bahia se suma a banco, STATCOM y SSSC por igual,
#      porque la Tabla 2.3-8 no incluye posicion de barra para ninguno de los
#      tres. Bahias en MTEP24 T4.2-1 p.41, fila "Add 1 position (ring bus)".
# ieee24/facts.dat --- STATCOM top-6 Qd (226,013$/MVAr x150 + bahia por kV); SSSC top-4 x
# (159,750$/MVAr x 44 MVA serie + bahia 1.70 = 8.73). MISO MTEP24 T2.3-8, USD2024.
param: NST: st_bus st_g st_b st_Vmin st_Vmax st_S st_cost :=
  ST1 18 0 -10 0.9 1.1 1.5 36.1
  ST2 15 0 -10 0.9 1.1 1.5 36.1
  ST3 13 0 -10 0.9 1.1 1.5 36.1
  ST4 10 0 -10 0.9 1.1 1.5 35.6
  ST5 14 0 -10 0.9 1.1 1.5 36.1
  ST6 19 0 -10 0.9 1.1 1.5 36.1
;

# RATINGS DEL SSSC --- RECONCILIADOS (rev. 2026-08-20)
#  sc_S es el termico de la RAMA compensada, no del dispositivo: una fuente
#  serie no cambia el conductor de la anfitriona. Valia 2.0 contra el_S=2.20 de
#  E2/E5/E12/E13, o sea un -9.1% de recorte termico que castigaba al SSSC sin
#  justificacion fisica. Se fija sc_S := el_S[anfitriona] = 2.20.
#  sc_Sabs = sc_Vmax x sc_S = 0.2 x 2.20 = 0.44 (rev. 2026-08-23); con S=2.20 el
#  limite que ata es sc_Sabs, que a corriente plena deja insertar 0.2 pu (su tension maxima) a corriente plena.
param: LSC: sc_line sc_r sc_x sc_Vmax sc_S sc_Sabs sc_cost sc_bsh :=
  SC1  E2  0.0546  0.2112  0.2  2.20  0.44  8.73  0.028600
  SC2  E5  0.0497  0.192  0.2  2.20  0.44  8.73  0.026000
  SC3  E12  0.0427  0.1651  0.2  2.20  0.44  8.73  0.022350
  SC4  E13  0.0427  0.1651  0.2  2.20  0.44  8.73  0.022350
;
# caps_lit.dat --- BANCOS: 4 candidatos, 50 MVAr c/u (modulo unico).
# Literatura/practica: modulos discretos de 50 MVAr (MISO MTEP24, 11873 $/MVAr
# -> 0.59 M$/50MVAr). Barras de mayor Qd NO cubiertas por STATCOM (nicho propio):
#   8 (centro de carga, aterrizaje del corredor), 3, 9, 6.
# (unico parametro modificado; red/carga/candidatos/costos intactos)
param: NBC: bc_bus bc_Hmax bc_qmod bc_cmod :=
  BC8 8 1 0.5 2.29
  BC3 3 1 0.5 2.29
  BC9 9 1 0.5 2.29
  BC6 6 1 0.5 2.29
;
param tan_amax     := 0.8391;
param theta_max_rad := 0.6981;

# --- load_scale AUTORITATIVO: unico valor efectivo del escenario (bulk v4) ---
# La calibracion de tighten.dat (0.95) corresponde al dataset IEEE-24 CLASICO
# (base.dat) y NO aplica aqui; ya fue omitida al concatenar. Este pin final
# garantiza load_scale=0.75 ante cualquier reconcatenacion (ultima asignacion gana).
let load_scale := 0.75;
